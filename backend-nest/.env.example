NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=secret
DB_NAME=taskmanager

JWT_ACCESS_SECRET=change-me-at-least-32-characters-long-for-access-token
JWT_REFRESH_SECRET=change-me-too-and-different-from-access-token-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

REDIS_HOST=localhost
REDIS_PORT=6379

STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=task-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Get this from @BotFather on Telegram (/newbot). Leave blank to disable
# Telegram notifications.
TELEGRAM_BOT_TOKEN=

DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
CORS_ORIGINS=http://localhost:5173
